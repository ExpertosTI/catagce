# Solo referencia para instalación nueva. En servidores con Catagce ya desplegado,
# NO copie encima de su .env — conserve DB_PASSWORD, JWT_SECRET y demás valores.

DB_USER=catagce_admin
DB_PASSWORD=
DB_NAME=catagce_prod
JWT_SECRET=

# URLs públicas (si faltan, deploy-quickctgo.sh las añade sin sobrescribir)
NEXT_PUBLIC_API_URL=https://api.catagce.renace.tech/api
NEXT_PUBLIC_SITE_URL=https://catagce.renace.tech
NEXT_PUBLIC_ADMIN_URL=https://catagce.renace.tech
NEXT_PUBLIC_COMPANY_SLUG=catagce
NEXT_PUBLIC_APP_NAME=CATAGCE

# Opcional — asistente IA
GEMINI_API_KEY=

# WhatsApp: use .evolution.local en la raíz del proyecto (mismo patrón Renace).
# El deploy lo carga sin modificar su .env.

ADMIN_EMAIL=
ADMIN_PASSWORD=
