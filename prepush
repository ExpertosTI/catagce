#!/bin/bash
# ==============================================================================
# 🚀 CATAGCE FULL-STACK PRE-PUSH v3.3
# ==============================================================================
set -euo pipefail

cleanup() {
    echo "🔄 Finalizing: Restoring Mac local environment..."
    pnpm install --no-frozen-lockfile || true
    echo "✅ Local environment restored."
}
trap cleanup EXIT

echo "-----------------------------------"
echo "💻 Starting Full-Stack Build (Mac)..."
echo "-----------------------------------"

# 0. Instant Purge
echo "🧹 [1/6] Purging old files..."
TIMESTAMP=$(date +%s)
mv node_modules .node_modules_purge_$TIMESTAMP 2>/dev/null || true
(rm -rf .node_modules_purge_$TIMESTAMP &) 2>/dev/null
rm -rf apps/*/.next apps/*/dist packages/*/dist workers/*/dist .turbo 2>/dev/null || true

# 1. Install & Build
echo "📦 [2/6] Installing dev dependencies..."
pnpm install --no-frozen-lockfile

echo "🏗️  [3/6] Compiling project (Turbo Build)..."
pnpm exec turbo build --continue || echo "⚠️ Build had minor errors, checking artifacts..."

# 2. Linux Production Bundle
echo "🧹 [4/6] Preparing Linux production bundle..."
rm -rf node_modules
npm_config_platform=linux npm_config_arch=x64 npm_config_libc=musl pnpm install --prod --no-frozen-lockfile --node-linker=hoisted

echo "🔗 [5/6] Solidifying internal packages & Compressing..."
mkdir -p node_modules/@catagce
for pkg in db ui domain contracts; do
    cp -r packages/$pkg node_modules/@catagce/ 2>/dev/null || true
done

tar -cJf deps.tar.xz node_modules
echo "✅ Package size: $(du -h deps.tar.xz)"

# 3. Git Sync
echo "🛰️  [6/6] Syncing everything with GitHub..."
git rm -rf --cached . 2>/dev/null || true
git add .gitignore
git add -f deps.tar.xz

# Validar y agregar DIST de la API
if [ -d "apps/api/dist" ]; then 
    git add -f apps/api/dist
else 
    echo "❌ ERROR: API dist missing."; exit 1; 
fi

# Validar y agregar DIST de los Workers
for worker in catalog-renderer media-processor notifications; do
    if [ -d "workers/$worker/dist" ]; then
        echo "✅ Worker $worker dist found."
        git add -f workers/$worker/dist
    else
        echo "❌ ERROR: Worker $worker dist missing."; exit 1;
    fi
done

# Validar y agregar STANDALONE de la Web
if [ -d "apps/buyer-web/.next/standalone" ]; then 
    git add -f apps/buyer-web/.next/standalone
    git add -f apps/buyer-web/.next/static
    git add -f apps/buyer-web/public
else 
    echo "❌ ERROR: Next.js standalone missing."; exit 1; 
fi

git add -A
git commit -m "🚀 Full-Stack Deploy: API + Web + Workers + Deps" --allow-empty
git push origin deploy/stable-production --force

echo "-----------------------------------"
echo "✨ SYSTEM PUSHED TO GITHUB ✨"
echo "-----------------------------------"
