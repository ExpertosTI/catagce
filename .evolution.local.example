# Evolution API (tu evoapi) — clave GLOBAL de admin (AUTHENTICATION_API_KEY).
# NO uses el token de una instancia del Manager como EVOLUTION_API_KEY.
EVOLUTION_API_URL=https://evoapi.renace.tech
EVOLUTION_API_KEY=tu-api-key-global
# Opcional: ya NO se usa para enviar OTP automáticamente.
# El número de notificaciones lo elige el platform admin escaneando QR en:
#   /dashboard/platform/whatsapp
# EVOLUTION_INSTANCE=
# Destinos admin (quién recibe avisos ops), separados por coma — upsert en .env, no en git:
# PLATFORM_NOTIFY_PHONES=1849…
