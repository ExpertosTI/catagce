# ── Database ────────────────────────────────────────────────────────────────
DB_USER=catagce_admin
DB_PASSWORD=change_this_in_production
DB_NAME=catagce_prod
DATABASE_URL=postgres://catagce_admin:change_this_in_production@db:5432/catagce_prod

# ── Auth ─────────────────────────────────────────────────────────────────────
# Must be ≥ 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=generate_a_random_string_of_at_least_32_characters

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── API ──────────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=https://catalogo.jhosuacomercial.com

# ── WhatsApp (notifications worker) ─────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
