# ── Database ────────────────────────────────────────────────────────────────
DB_USER=catagce_admin
DB_PASSWORD=change_this_in_production
DB_NAME=catagce_prod
DATABASE_URL=postgres://catagce_admin:change_this_in_production@db:5432/catagce_prod

# Connection pool tuning (per API instance)
DB_POOL_MAX=20
DB_POOL_IDLE=30
DB_POOL_CONNECT_TIMEOUT=10
# Set to 1 when connecting through pgBouncer in transaction mode
DB_PGBOUNCER=0

# ── Migrations ──────────────────────────────────────────────────────────────
# Set to 1 to skip embedded migrations on startup (debug only)
SKIP_MIGRATIONS=0
# Set to 1 to crash the API if migrations fail (recommended for prod)
MIGRATIONS_STRICT=1

# ── Auth ─────────────────────────────────────────────────────────────────────
# Must be ≥ 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=generate_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# One-time admin bootstrap. Leave empty after the admin is created and rotate the password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Catagce Admin
BOOTSTRAP_ADMIN_SLUG=admin

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── API ──────────────────────────────────────────────────────────────────────
PORT=42100
NODE_ENV=production
# Comma-separated list, also accepts CORS_ORIGIN as a fallback
CORS_ORIGINS=https://catagce.renace.tech,https://catalogo.jhosuacomercial.com

# ── WhatsApp (notifications worker) ─────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# ── Seed (dev only) ─────────────────────────────────────────────────────────
SEED_SLUG=demo
SEED_NAME=Demo Comercio
SEED_EMAIL=demo@catagce.local
