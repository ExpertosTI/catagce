DB_USER=ghome_admin
DB_PASSWORD=change_this_in_production
DB_NAME=ghome_prod
DATABASE_URL=postgres://ghome_admin:change_this_in_production@ghome-db:5432/ghome_prod
# Obligatorio en producción — generar con: openssl rand -base64 32
JWT_SECRET=

# Opcional — activa el asistente de IA (descripciones de producto, chat, notificaciones inteligentes)
# Sin esta clave, todo funciona igual pero con respuestas basadas en plantillas.
GEMINI_API_KEY=

# Producción — generalhome.tech
NEXT_PUBLIC_SITE_URL=https://generalhome.tech
NEXT_PUBLIC_ADMIN_URL=https://admin.generalhome.tech
NEXT_PUBLIC_API_URL=https://api.generalhome.tech/api
NEXT_PUBLIC_COMPANY_SLUG=generalhome
CORS_ORIGINS=https://generalhome.tech,https://www.generalhome.tech,https://admin.generalhome.tech,http://localhost:3001,http://localhost:3002

# Desarrollo local (descomentar si aplica)
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Solo para seed inicial — el script ghome-ensure-secrets.sh genera una contraseña fuerte automáticamente
ADMIN_EMAIL=admin@generalhome.tech
ADMIN_PASSWORD=

# Opcional: IP pública del servidor (sal para mezclar secretos; si vacío se detecta al generar)
GHOME_SERVER_IP=

# Deshabilitado por defecto en producción. Solo para bootstrap controlado:
# ALLOW_STAFF_REGISTER=true

# Inicio de sesión con Google y Apple (Firebase Auth)
# 1. Crear proyecto en https://console.firebase.google.com
# 2. Activar proveedores Google y Apple en Authentication
# 3. Agregar generalhome.tech y localhost a dominios autorizados
# 4. Crear cuenta de servicio y copiar credenciales al API
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
