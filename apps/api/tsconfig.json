{
  "extends": "@catagce/typescript-config/base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": "./",
    "noEmit": false,
    "skipLibCheck": true

  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
