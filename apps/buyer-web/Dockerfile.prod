FROM node:20-alpine
RUN apk add --no-cache wget xz
WORKDIR /app

# En modo standalone, Next.js ya empaqueta todo en esta carpeta
# Nota: La carpeta standalone contiene un servidor de node puro
COPY apps/buyer-web/.next/standalone ./
COPY apps/buyer-web/.next/static ./.next/static
COPY apps/buyer-web/public ./public

EXPOSE 42101
ENV NODE_ENV=production
ENV PORT=42101
ENV HOSTNAME="0.0.0.0"

# Ejecutamos el servidor standalone de Next.js (Sin dependencia del binario 'next')
CMD ["node", "server.js"]
