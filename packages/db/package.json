{
  "name": "@catagce/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/schema.ts --format cjs,esm --watch --dts",
    "generate": "drizzle-kit generate:pg",
    "push": "drizzle-kit push:pg",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "postgres": "^3.4.0",
    "drizzle-kit": "^0.20.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@catagce/typescript-config": "workspace:*",
    "drizzle-kit": "^0.20.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.1",
    "dotenv": "^16.4.5",
    "typescript": "^5.0.0"
  }
}
